# ==========================================
# RAG Interview Platform Environment Config
# ==========================================

# Database Connection
# For Local Dev (SQLite): sqlite+aiosqlite:///./local_storage_do_not_commit.db
# For Production (PostgreSQL): postgresql+asyncpg://user:password@host:5432/interview_db
DATABASE_URL=sqlite+aiosqlite:///./local_storage_do_not_commit.db

# Third-Party API Keys (DO NOT COMMIT THE ACTUAL KEYS)
OPENAI_API_KEY=your_openai_api_key_here
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
